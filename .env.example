# Set only for live mode. HA_URL is the base URL, without /api.
HA_URL=
HA_TOKEN=
# Required for sign-in, even in demo mode. Use a unique password (12+ characters).
PANEL_PASSWORD=
# Listen on the LAN for iPad access. Use a specific LAN IPv4 to restrict interfaces,
# or 127.0.0.1 to test only on this computer. Never forward this port to the internet.
PANEL_BIND_IP=0.0.0.0
PANEL_PORT=8090
